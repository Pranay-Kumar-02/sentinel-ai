# ─────────────────────────────────────────────────────────────────────────────
# SENTINEL AI — Backend Environment Configuration Template
# Copy this file to .env and provide your actual API keys.
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API Key (Required for LLM Threat Analysis)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# VirusTotal API Key (Required for 70+ AV Engine Scans)
# Get a free API key (4 requests/min) at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing API Key (Required for Google Threat Scanning)
# Enable Safe Browsing APIs in Google Cloud Console: https://console.cloud.google.com/
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here

# URLhaus Auth Key (abuse.ch) (Required for Live Malicious URL Feeds)
# Register at: https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=your_urlhaus_auth_key_here

# Production CORS Allowed Origins
# Comma-separated list of frontend URLs permitted to call this backend.
# Localhost:5173 and localhost:5174 are enabled by default for development.
# Example: https://sentinel-ai.vercel.app,https://sentinel-ai.onrender.com
ALLOWED_ORIGINS=

# Application Metadata
APP_NAME=Sentinel AI
VERSION=3.0.0
